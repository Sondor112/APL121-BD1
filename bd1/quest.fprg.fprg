<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="guess_game"/>
        <attribute name="authors" value="HUAWEI"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-26 08:43:25 PM"/>
        <attribute name="created" value="SFVBV0VJO0RFU0tUT1AtMTlHUjBVTDsyMDI2LTEwLTI2OzA2OjEzOjAxIFBNOzI3NzY="/>
        <attribute name="edited" value="SFVBV0VJO0RFU0tUT1AtMTlHUjBVTDsyMDI2LTEwLTI2OzA4OjQzOjI1IFBNOzI7Mjg5Ng=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="secretNumber, guess, attempts, bestrecord, gameloop" type="Integer" array="False" size=""/>
            <assign variable="bestRecord" expression="999"/>
            <for variable="gameloop" start="1" end="3" direction="inc" step="1">
                <assign variable="secretNumber" expression="Random(100)+1"/>
                <assign variable="attempts" expression="0"/>
                <assign variable="guess" expression="1"/>
            </for>
            <while expression="guess != secretNumber">
                <input variable="guess"/>
                <assign variable="attempts" expression="attempts + 1"/>
                <if expression="guess &gt; secretNumber">
                    <then>
                        <output expression="&quot;&#1048;&#1093; &#1073;&#1072;&#1081;&#1085;&#1072;&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="guess &lt; secretNumber">
                            <then>
                                <output expression="&quot;&#1041;&#1072;&#1075;&#1072; &#1073;&#1072;&#1081;&#1085;&#1072;&quot;" newline="True"/>
                            </then>
                            <else/>
                        </if>
                    </else>
                </if>
            </while>
            <output expression="&quot;&#1041;&#1072;&#1103;&#1088; &#1093;&#1199;&#1088;&#1075;&#1101;&#1077;! &#1058;&#1072;&quot; &amp;attempts&amp; &quot;&#1086;&#1088;&#1086;&#1083;&#1076;&#1083;&#1086;&#1075;&#1086;&#1086;&#1088; &#1090;&#1072;&#1072;&#1083;&#1072;&#1072;&quot;" newline="True"/>
            <if expression="attempts &lt; bestRecord">
                <then>
                    <assign variable="bestRecord" expression="attempts"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
